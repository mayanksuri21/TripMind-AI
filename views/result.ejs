<%- include('partials/header') %>

<!-- Custom Result CSS -->
<link rel="stylesheet" href="/css/result.css">

<!-- Hero Banner -->
<section class="hero-banner py-5 animated-bg">
    <div class="container text-center">
        <div class="hero-content">
            <h1 class="display-3 fw-bold mb-4">
                <i class="bi bi-geo-alt me-2"></i><%= itinerary.tripSummary.destination %>
            </h1>
            <p class="lead text-muted mb-5">
                <i class="bi bi-calendar3 me-2"></i>
                <%= itinerary.tripSummary.startDate %> - <%= itinerary.tripSummary.endDate %>
                &nbsp;•&nbsp;
                <%= itinerary.tripSummary.duration %> days
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <span class="badge badge-primary"><i class="bi bi-currency-exchange me-1"></i><%= itinerary.tripSummary.budgetTier %></span>
                <span class="badge badge-success"><i class="bi bi-people me-1"></i><%= itinerary.tripSummary.travelers %></span>
                <span class="badge badge-accent"><i class="bi bi-person-walking me-1"></i><%= itinerary.tripSummary.travelStyle %></span>
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="itinerary-content py-5">
    <div class="container">
        <!-- Action Buttons -->
        <div class="text-center d-flex flex-wrap justify-content-center gap-3 mb-5 no-print">
            <button class="btn btn-outline-primary px-4" onclick="copyText(`<%= JSON.stringify(itinerary, null, 2).replace(/`/g, '\\`').replace(/\$/g, '\\$') %>`, 'Itinerary')">
                <i class="bi bi-clipboard me-2"></i> Copy Itinerary
            </button>
            <button class="btn btn-outline-primary px-4" onclick="window.print()">
                <i class="bi bi-printer me-2"></i> Print Itinerary
            </button>
            <a href="/planner/download" class="btn btn-success px-4">
                <i class="bi bi-download me-2"></i> Download PDF
            </a>
        </div>

        <!-- Trip Summary -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-card-checklist"></i>
                <h2 class="fw-bold">Trip Overview</h2>
            </div>
            <div class="app-card">
                <p class="mb-0"><%= itinerary.tripSummary.overallDescription %></p>
            </div>
        </div>

        <!-- Destination Overview -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-info-circle"></i>
                <h2 class="fw-bold">Destination Overview</h2>
            </div>
            <div class="app-card">
                <p class="mb-0"><%= itinerary.destinationOverview.description %></p>
            </div>
        </div>

        <!-- Weather Guide -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-cloud-sun"></i>
                <h2 class="fw-bold">Weather Guide</h2>
            </div>
            <div class="app-card">
                <p class="mb-2"><strong>Typical Weather:</strong> <%= itinerary.weatherGuide.typicalWeather %></p>
                <p class="mb-2"><strong>Temperature Range:</strong> <%= itinerary.weatherGuide.temperatureRange %></p>
                <p class="mb-2"><strong>Precipitation:</strong> <%= itinerary.weatherGuide.precipitation %></p>
                <p class="mb-0"><strong>Advice:</strong> <%= itinerary.weatherGuide.advice %></p>
            </div>
        </div>

        <!-- Day-wise Itinerary (Accordion) -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-calendar-week"></i>
                <h2 class="fw-bold">Day-by-Day Itinerary</h2>
            </div>
            <div class="accordion" id="itineraryAccordion">
                <% itinerary.dailyPlan.forEach((day, index) => { %>
                <div class="accordion-item mb-2">
                    <h2 class="accordion-header" id="heading<%= index %>">
                        <button class="accordion-button <%= index === 0 ? '' : 'collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>" aria-expanded="<%= index === 0 %>" aria-controls="collapse<%= index %>">
                            <i class="bi bi-calendar-check me-2"></i> Day <%= day.day %>: <%= day.date %>
                        </button>
                    </h2>
                    <div id="collapse<%= index %>" class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>" aria-labelledby="heading<%= index %>" data-bs-parent="#itineraryAccordion">
                        <div class="accordion-body">
                            <div class="timeline-item">
                                <div class="timeline-dot"><i class="bi bi-sunrise"></i></div>
                                <div class="ps-3">
                                    <h5 class="fw-bold">Morning</h5>
                                    <p class="mb-0"><strong><%= day.morning.activity %></strong></p>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1"></i><%= day.morning.location %></small>
                                    <% if (day.morning.duration) { %>
                                        <small class="text-muted ms-3"><i class="bi bi-clock me-1"></i><%= day.morning.duration %></small>
                                    <% } %>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-dot"><i class="bi bi-sun"></i></div>
                                <div class="ps-3">
                                    <h5 class="fw-bold">Afternoon</h5>
                                    <p class="mb-0"><strong><%= day.afternoon.activity %></strong></p>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1"></i><%= day.afternoon.location %></small>
                                    <% if (day.afternoon.duration) { %>
                                        <small class="text-muted ms-3"><i class="bi bi-clock me-1"></i><%= day.afternoon.duration %></small>
                                    <% } %>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-dot"><i class="bi bi-moon-stars"></i></div>
                                <div class="ps-3">
                                    <h5 class="fw-bold">Evening</h5>
                                    <p class="mb-0"><strong><%= day.evening.activity %></strong></p>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1"></i><%= day.evening.location %></small>
                                    <% if (day.evening.duration) { %>
                                        <small class="text-muted ms-3"><i class="bi bi-clock me-1"></i><%= day.evening.duration %></small>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>

        <!-- Budget Breakdown -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-wallet2"></i>
                <h2 class="fw-bold">Budget Breakdown</h2>
            </div>
            <div class="app-card">
                <h5 class="text-primary fw-bold mb-4">Total: <%= itinerary.budgetBreakdown.totalEstimate %></h5>
                <div class="row g-3">
                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 border rounded bg-light">
                            <i class="bi bi-house-door text-muted me-2"></i> Accommodation: <%= itinerary.budgetBreakdown.accommodation %>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 border rounded bg-light">
                            <i class="bi bi-egg-fried text-muted me-2"></i> Food: <%= itinerary.budgetBreakdown.food %>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 border rounded bg-light">
                            <i class="bi bi-car-front text-muted me-2"></i> Transport: <%= itinerary.budgetBreakdown.transportation %>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 border rounded bg-light">
                            <i class="bi bi-ticket-perforated text-muted me-2"></i> Activities: <%= itinerary.budgetBreakdown.activities %>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 border rounded bg-light">
                            <i class="bi bi-three-dots text-muted me-2"></i> Miscellaneous: <%= itinerary.budgetBreakdown.miscellaneous %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Accommodation Suggestions -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-house-heart"></i>
                <h2 class="fw-bold">Accommodation Suggestions</h2>
            </div>
            <div class="row g-3">
                <% itinerary.accommodationSuggestions.forEach(acc => { %>
                <div class="col-md-6">
                    <div class="app-card h-100">
                        <h5 class="fw-bold"><%= acc.name %></h5>
                        <p class="text-muted mb-1"><i class="bi bi-pin-map me-1"></i><%= acc.location %></p>
                        <span class="badge badge-primary mb-2"><%= acc.priceRange %></span>
                        <p class="mb-0"><%= acc.description %></p>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>

        <!-- Transportation Plan -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-airplane"></i>
                <h2 class="fw-bold">Transportation Plan</h2>
            </div>
            <div class="app-card">
                <p class="mb-2"><strong>Arrival:</strong> <%= itinerary.transportationPlan.arrival %></p>
                <p class="mb-2"><strong>Getting Around:</strong> <%= itinerary.transportationPlan.gettingAround %></p>
                <p class="mb-0"><strong>Departure:</strong> <%= itinerary.transportationPlan.departure %></p>
            </div>
        </div>

        <!-- Food Recommendations -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-utensils"></i>
                <h2 class="fw-bold">Food Recommendations</h2>
            </div>
            <div class="app-card mb-3">
                <h6 class="mb-2 fw-bold"><i class="bi bi-star me-1"></i> Must Try:</h6>
                <div class="d-flex flex-wrap gap-2">
                    <% itinerary.foodRecommendations.mustTry.forEach(food => { %>
                    <span class="badge badge-accent"><%= food %></span>
                    <% }) %>
                </div>
            </div>
            <div class="row g-3">
                <% itinerary.foodRecommendations.restaurants.forEach(rest => { %>
                <div class="col-md-6">
                    <div class="app-card h-100">
                        <h5 class="fw-bold"><%= rest.name %></h5>
                        <p class="text-muted mb-1"><i class="bi bi-pin-map me-1"></i><%= rest.location %></p>
                        <span class="badge badge-primary mb-2"><%= rest.priceRange %></span>
                        <p class="mb-0"><%= rest.description %></p>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>

        <!-- Packing Checklist -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-bag-check"></i>
                <h2 class="fw-bold">Packing Checklist</h2>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="app-card h-100">
                        <h6 class="fw-bold"><i class="bi bi-tshirt me-1"></i> Clothing</h6>
                        <ul class="list-unstyled mb-0">
                            <% itinerary.packingChecklist.clothing.forEach(item => { %>
                            <li class="checklist-item"><i class="bi bi-check2-circle"></i><%= item %></li>
                            <% }) %>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="app-card h-100">
                        <h6 class="fw-bold"><i class="bi bi-droplet-half me-1"></i> Toiletries</h6>
                        <ul class="list-unstyled mb-0">
                            <% itinerary.packingChecklist.toiletries.forEach(item => { %>
                            <li class="checklist-item"><i class="bi bi-check2-circle"></i><%= item %></li>
                            <% }) %>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="app-card h-100">
                        <h6 class="fw-bold"><i class="bi bi-phone me-1"></i> Electronics</h6>
                        <ul class="list-unstyled mb-0">
                            <% itinerary.packingChecklist.electronics.forEach(item => { %>
                            <li class="checklist-item"><i class="bi bi-check2-circle"></i><%= item %></li>
                            <% }) %>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="app-card h-100">
                        <h6 class="fw-bold"><i class="bi bi-file-earmark-check me-1"></i> Documents & More</h6>
                        <ul class="list-unstyled mb-0">
                            <% itinerary.packingChecklist.documents.forEach(item => { %>
                            <li class="checklist-item"><i class="bi bi-check2-circle"></i><%= item %></li>
                            <% }) %>
                            <% itinerary.packingChecklist.miscellaneous.forEach(item => { %>
                            <li class="checklist-item"><i class="bi bi-check2-circle"></i><%= item %></li>
                            <% }) %>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Clothing Recommendations -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-person-rolodex"></i>
                <h2 class="fw-bold">Clothing Recommendations</h2>
            </div>
            <div class="app-card">
                <p class="mb-2"><strong>Daywear:</strong> <%= itinerary.clothingRecommendations.daywear %></p>
                <p class="mb-2"><strong>Eveningwear:</strong> <%= itinerary.clothingRecommendations.eveningwear %></p>
                <p class="mb-0"><strong>Footwear:</strong> <%= itinerary.clothingRecommendations.footwear %></p>
            </div>
        </div>

        <!-- Photo Spots -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-camera"></i>
                <h2 class="fw-bold">Photo Spots</h2>
            </div>
            <div class="row g-3">
                <% itinerary.photoSpots.forEach(spot => { %>
                <div class="col-md-6">
                    <div class="app-card h-100">
                        <h5 class="fw-bold"><%= spot.name %></h5>
                        <p class="text-muted mb-1"><i class="bi bi-pin-map me-1"></i><%= spot.location %></p>
                        <% if (spot.bestTime) { %>
                            <p class="text-muted mb-1"><i class="bi bi-clock me-1"></i>Best Time: <%= spot.bestTime %></p>
                        <% } %>
                        <p class="mb-0"><%= spot.description %></p>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>

        <!-- Hidden Gems -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-gem"></i>
                <h2 class="fw-bold">Hidden Gems</h2>
            </div>
            <div class="row g-3">
                <% itinerary.hiddenGems.forEach(gem => { %>
                <div class="col-md-6">
                    <div class="app-card h-100">
                        <h5 class="fw-bold"><%= gem.name %></h5>
                        <p class="text-muted mb-1"><i class="bi bi-pin-map me-1"></i><%= gem.location %></p>
                        <p class="mb-0"><%= gem.description %></p>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>

        <!-- Travel Tips -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-lightbulb"></i>
                <h2 class="fw-bold">Travel Tips</h2>
            </div>
            <div class="app-card">
                <ul class="list-unstyled mb-0">
                    <% itinerary.travelTips.forEach(tip => { %>
                    <li class="mb-2"><i class="bi bi-lightbulb-fill text-warning me-2"></i><%= tip %></li>
                    <% }) %>
                </ul>
            </div>
        </div>

        <!-- Safety Tips -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-shield-check"></i>
                <h2 class="fw-bold">Safety Tips</h2>
            </div>
            <div class="app-card">
                <ul class="list-unstyled mb-0">
                    <% itinerary.safetyTips.forEach(tip => { %>
                    <li class="mb-2"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i><%= tip %></li>
                    <% }) %>
                </ul>
            </div>
        </div>

        <!-- Emergency Information -->
        <div class="mb-5">
            <div class="section-heading">
                <i class="bi bi-telephone-outbound"></i>
                <h2 class="fw-bold">Emergency Information</h2>
            </div>
            <div class="app-card">
                <p class="mb-2"><strong>Police:</strong> <%= itinerary.emergencyInformation.police %></p>
                <p class="mb-2"><strong>Ambulance:</strong> <%= itinerary.emergencyInformation.ambulance %></p>
                <p class="mb-2"><strong>Fire:</strong> <%= itinerary.emergencyInformation.fire %></p>
                <p class="mb-2"><strong>Embassy:</strong> <%= itinerary.emergencyInformation.embassy %></p>
                <p class="mb-0"><strong>Local Contacts:</strong></p>
                <ul class="list-unstyled">
                    <% itinerary.emergencyInformation.localEmergencyContacts.forEach(contact => { %>
                    <li><i class="bi bi-telephone me-2"></i><%= contact %></li>
                    <% }) %>
                </ul>
            </div>
        </div>

        <!-- Back to Planner -->
        <div class="text-center no-print">
            <a href="/planner" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-arrow-left me-2"></i> Plan Another Trip
            </a>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
