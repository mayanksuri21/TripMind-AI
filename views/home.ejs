<%- include('partials/header') %>

<div class="animated-bg">
  <div class="container hero-section">
    <div class="row align-items-center justify-content-center text-center">
      <div class="col-lg-8">
        <span class="badge badge-accent mb-3">
          <i class="bi bi-stars me-1"></i> AI-Powered Travel Planning
        </span>
        <h1 class="display-4 mb-4 fw-bold" style="line-height: 1.15;">
          Plan Perfect Trips with <span style="background: linear-gradient(135deg, #4F46E5, #7C3AED); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">TripMind AI</span>
        </h1>
        <p class="lead text-muted mb-5 mx-auto" style="max-width: 650px;">
          Generate personalized, day-by-day itineraries tailored to your budget, travel style, and interests. All powered by Google Gemini AI.
        </p>
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
          <a href="/planner" class="btn btn-primary btn-lg px-5 py-3 d-flex align-items-center justify-content-center">
            Start Planning <i class="bi bi-arrow-right-short ms-2 fs-4"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Features Section -->
<section id="features" class="container py-5 my-5">
  <div class="text-center mb-5">
    <span class="badge badge-accent mb-3">
      <i class="bi bi-stars me-1"></i> Why TripMind AI?
    </span>
    <h2 class="fw-bold mb-3">Everything You Need to Plan the Perfect Trip</h2>
    <p class="text-muted mx-auto" style="max-width: 650px;">
      TripMind AI combines AI-powered planning with practical travel tools to create personalized itineraries in seconds.
    </p>
  </div>

  <div class="row g-4">
    <!-- Feature 1 -->
    <div class="col-md-6 col-lg-4">
      <div class="app-card h-100 fade-up">
        <div class="feature-icon mb-4">
          <i class="bi bi-robot"></i>
        </div>
        <h4 class="fw-bold mb-3">AI Itinerary Generator</h4>
        <p class="text-muted">
          Creates comprehensive travel plans tailored to your preferences, destination, and travel dates using advanced AI.
        </p>
      </div>
    </div>
    <!-- Feature 2 -->
    <div class="col-md-6 col-lg-4">
      <div class="app-card h-100 fade-up">
        <div class="feature-icon mb-4">
          <i class="bi bi-cash-coin"></i>
        </div>
        <h4 class="fw-bold mb-3">Budget Planning</h4>
        <p class="text-muted">
          Detailed cost breakdowns for accommodations, food, transportation, and activities to help you stay on budget.
        </p>
      </div>
    </div>
    <!-- Feature 3 -->
    <div class="col-md-6 col-lg-4">
      <div class="app-card h-100 fade-up">
        <div class="feature-icon mb-4">
          <i class="bi bi-lightbulb"></i>
        </div>
        <h4 class="fw-bold mb-3">Smart Recommendations</h4>
        <p class="text-muted">
          Curated suggestions for places to visit, local restaurants, and unique experiences you won't want to miss.
        </p>
      </div>
    </div>
    <!-- Feature 4 -->
    <div class="col-md-6 col-lg-4">
      <div class="app-card h-100 fade-up">
        <div class="feature-icon mb-4">
          <i class="bi bi-calendar3"></i>
        </div>
        <h4 class="fw-bold mb-3">Day-wise Schedule</h4>
        <p class="text-muted">
          Structured daily plans with morning, afternoon, and evening activities optimized for your trip duration.
        </p>
      </div>
    </div>
    <!-- Feature 5 -->
    <div class="col-md-6 col-lg-4">
      <div class="app-card h-100 fade-up">
        <div class="feature-icon mb-4">
          <i class="bi bi-file-earmark-pdf"></i>
        </div>
        <h4 class="fw-bold mb-3">PDF Export</h4>
        <p class="text-muted">
          Download professional, beautifully formatted PDF versions of your itinerary for offline access and sharing.
        </p>
      </div>
    </div>
    <!-- Feature 6 -->
    <div class="col-md-6 col-lg-4">
      <div class="app-card h-100 fade-up">
        <div class="feature-icon mb-4">
          <i class="bi bi-google"></i>
        </div>
        <h4 class="fw-bold mb-3">Powered by Google Gemini AI</h4>
        <p class="text-muted">
          Leverages state-of-the-art Google Gemini AI for intelligent, accurate, and creative travel planning.
        </p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
